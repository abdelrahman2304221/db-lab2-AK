<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Register</title>
  <style>
    :root {
      --blue: #89cff0;
      --blue-hover: #6dbde3;
      --blue-text: #1d6a96;
      --sky: #e6f4fc;
      --ink: #12323f;
      --muted: #5d6f76;
      --line: #cfdadd;
      --danger: #b42318;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      font-family: "Segoe UI", Arial, sans-serif;
      color: var(--ink);
      background: #ffffff;
    }

    .side {
      flex: 1;
      background: var(--blue);
      color: var(--ink);
      padding: 48px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 28px;
    }
    .side h2 {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 38px;
      line-height: 1.15;
      font-weight: 700;
      max-width: 14ch;
    }
    .side p { margin: 0; max-width: 36ch; line-height: 1.5; }
    .preview { list-style: none; margin: 0; padding: 0; max-width: 320px; }
    .preview li {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      margin-bottom: 8px;
      background: rgba(255, 255, 255, 0.6);
      border-radius: 6px;
      font-size: 15px;
    }
    .preview .box {
      width: 18px;
      height: 18px;
      border: 2px solid var(--blue-text);
      border-radius: 4px;
      flex-shrink: 0;
    }
    .preview .done { color: var(--muted); text-decoration: line-through; }
    .preview .done .box { background: var(--blue-text); }

    .main {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 32px 20px;
    }
    .form-box { width: 100%; max-width: 380px; }
    .form-box h1 { margin: 0 0 6px; font-size: 28px; }
    .subtitle { margin: 0 0 24px; color: var(--muted); font-size: 15px; }

    label { display: block; margin: 16px 0 6px; font-size: 14px; font-weight: 600; }
    .req { color: var(--danger); }
    input {
      width: 100%;
      padding: 11px 12px;
      border: 1.5px solid var(--line);
      border-radius: 6px;
      font-size: 15px;
      color: var(--ink);
      background: #ffffff;
    }
    input:focus {
      outline: none;
      border-color: var(--blue);
      box-shadow: 0 0 0 3px var(--sky);
    }

    .pw-row { display: flex; gap: 8px; }
    .pw-row input { flex: 1; min-width: 0; }
    .toggle-pw {
      width: 68px;
      border: 1.5px solid var(--line);
      border-radius: 6px;
      background: #ffffff;
      color: var(--blue-text);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
    }
    .toggle-pw:hover { background: var(--sky); }
    .toggle-pw:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }

    button.submit {
      width: 100%;
      margin-top: 24px;
      padding: 13px;
      background: var(--blue);
      color: var(--ink);
      border: none;
      border-radius: 6px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
    }
    button.submit:hover { background: var(--blue-hover); }
    button.submit:focus-visible { outline: 3px solid var(--blue-text); outline-offset: 2px; }

    .errors {
      background: #fff1f0;
      border-left: 4px solid var(--danger);
      color: var(--danger);
      padding: 10px 14px;
      border-radius: 4px;
      margin-bottom: 8px;
      font-size: 14px;
    }
    .errors ul { margin: 0; padding-left: 18px; }

    .footer-text { margin-top: 22px; font-size: 14px; color: var(--muted); }
    .footer-text a { color: var(--blue-text); font-weight: 600; }

    @media (max-width: 760px) {
      .side { display: none; }
      .main { align-items: flex-start; padding-top: 40px; }
    }
  </style>
</head>
<body>
  <section class="side">
    <h2>Your day, one list.</h2>
    <p>Create an account to add what needs doing and tick it off when it is done.</p>
    <ul class="preview" aria-hidden="true">
      <li><span class="box"></span>Buy oat milk</li>
      <li class="done"><span class="box"></span>Finish the database lab</li>
      <li><span class="box"></span>Call mum</li>
    </ul>
  </section>

  <main class="main">
    <div class="form-box">
      <h1>Create account</h1>
      <p class="subtitle">Sign up to manage your to-do list.</p>

      <% if (errors.length > 0) { %>
        <div class="errors">
          <ul>
            <% errors.forEach(function(e) { %>
              <li><%= e %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form method="POST" action="/register" novalidate>
        <label for="name">Name <span class="req">*</span></label>
        <input type="text" id="name" name="name" value="<%= values.name || '' %>">

        <label for="email">Email <span class="req">*</span></label>
        <input type="email" id="email" name="email" value="<%= values.email || '' %>">

        <label for="password">Password <span class="req">*</span></label>
        <div class="pw-row">
          <input type="password" id="password" name="password">
          <button type="button" class="toggle-pw" data-target="password" aria-label="Show password">Show</button>
        </div>

        <label for="confirm_password">Confirm password <span class="req">*</span></label>
        <div class="pw-row">
          <input type="password" id="confirm_password" name="confirm_password">
          <button type="button" class="toggle-pw" data-target="confirm_password" aria-label="Show password">Show</button>
        </div>

        <button type="submit" class="submit">Create account</button>
      </form>

      <p class="footer-text">Already have an account? <a href="/login">Log in</a></p>
    </div>
  </main>

  <script>
    document.querySelectorAll('.toggle-pw').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var input = document.getElementById(btn.dataset.target);
        var showing = input.type === 'text';
        input.type = showing ? 'password' : 'text';
        btn.textContent = showing ? 'Show' : 'Hide';
        btn.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
      });
    });
  </script>
  <script src="/validate.js"></script>
</body>
</html>